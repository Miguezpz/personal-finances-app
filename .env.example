# Copy to .env.local (ignored by git) and fill in. Never commit real values.
# See specs/_archive/001-personal-finances-core/quickstart.md

# "true" → public demo: Mock Data Provider, zero calls to Supabase, read-only.
# "false" (or unset) → personal app backed by Supabase.
NEXT_PUBLIC_DEMO_MODE=false

# Public demo URL; the "Explore Demo / Recruiters" button on the personal deployment links here.
NEXT_PUBLIC_DEMO_URL=

# Required only when NEXT_PUBLIC_DEMO_MODE=false.
# Local values are printed by `pnpm exec supabase start`.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key ONLY (sb_publishable_... or the legacy anon key). NEVER the secret/service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
